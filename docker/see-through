#!/usr/bin/env bash
set -Eeuo pipefail

if [[ -r /run/see-through/runtime.env ]]; then
    # Generated by PID 1 from a fixed non-secret variable allowlist.
    source /run/see-through/runtime.env
fi
unset PUBLIC_KEY SSH_PUBLIC_KEY
export PYTHONPATH="/opt/see-through/common:/opt/see-through/server${PYTHONPATH:+:$PYTHONPATH}"
export SEE_THROUGH_DATA_DIR="${SEE_THROUGH_DATA_DIR:-/home/seethrough/data}"
export SEE_THROUGH_MODEL_CACHE="${SEE_THROUGH_MODEL_CACHE:-${HF_HOME:-/home/seethrough/.cache/huggingface}}"
export HF_HOME="$SEE_THROUGH_MODEL_CACHE"
export PYTHONUNBUFFERED=1
cd /opt/see-through

command="${1:-help}"
if [[ $# -gt 0 ]]; then
    shift
fi

run_inference() {
    local script="$1"
    shift
    local has_save_dir=0
    local argument
    for argument in "$@"; do
        if [[ "$argument" == --save_dir || "$argument" == --save_dir=* ]]; then
            has_save_dir=1
            break
        fi
    done
    if (( has_save_dir == 0 )); then
        mkdir -p "$SEE_THROUGH_DATA_DIR/cli"
        exec /opt/venv/bin/python "$script" --save_dir "$SEE_THROUGH_DATA_DIR/cli" "$@"
    fi
    exec /opt/venv/bin/python "$script" "$@"
}

case "$command" in
    infer)
        run_inference inference/scripts/inference_psd.py "$@"
        ;;
    infer-quantized)
        run_inference inference/scripts/inference_psd_quantized.py "$@"
        ;;
    infer-blockswap)
        run_inference inference/scripts/inference_psd_blockswap.py "$@"
        ;;
    server)
        exec /opt/venv/bin/python -m "${SEE_THROUGH_SERVER_MODULE:-seethrough_server}" "$@"
        ;;
    prefetch)
        exec /opt/venv/bin/python -m "${SEE_THROUGH_SERVER_MODULE:-seethrough_server}" prefetch "$@"
        ;;
    python)
        exec /opt/venv/bin/python "$@"
        ;;
    help|-h|--help)
        cat <<'EOF'
See-through container commands:
  see-through infer [inference_psd.py options]
  see-through infer-quantized [quantized options]
  see-through infer-blockswap [blockswap options]
  see-through prefetch [auto|bf16|nf4]
  see-through server
  see-through python [Python options]

Outputs default to $SEE_THROUGH_DATA_DIR/cli. Model downloads use
$SEE_THROUGH_MODEL_CACHE (also exported as HF_HOME).
EOF
        ;;
    *)
        printf 'Unknown command: %s\n' "$command" >&2
        exec "$command" "$@"
        ;;
esac
