{
  "name": "see-through-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1 --port 4321",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/check-csp.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "@fontsource/inter": "5.2.8",
    "astro": "7.0.7",
    "svelte": "5.56.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "svelte-check": "4.4.6",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
